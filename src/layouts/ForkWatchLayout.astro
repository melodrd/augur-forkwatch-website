---
import type { Locale } from "@/i18n/locales";
import Layout from "./Layout.astro";

type Props = {
  dateModified?: string;
  description: string;
  locale: Locale;
  title: string;
};

const { dateModified, description, locale, title } = Astro.props;
---

<Layout
  dateModified={dateModified}
  description={description}
  locale={locale}
  title={title}
>
  <slot />
</Layout>
