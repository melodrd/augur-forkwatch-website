---
import "@/styles/global.css";
import { getCopy, OG_LOCALES } from "@/i18n";
import type { Locale } from "@/i18n/locales";
import { withBase } from "@/lib/utils";

type Props = {
  author?: string;
  canonicalURL?: string;
  description?: string;
  keywords?: string[];
  locale?: Locale;
  noindex?: boolean;
  ogImage?: string;
  ogType?: string;
  title?: string;
};

const {
  author = "Augur Project",
  canonicalURL,
  description,
  keywords,
  locale = "en",
  noindex = false,
  ogImage = "/favicon.svg",
  ogType = "website",
  title,
} = Astro.props;

const copy = getCopy(locale);
const resolvedTitle = title ?? copy.meta.title;
const resolvedDescription = description ?? copy.meta.description;
const resolvedKeywords = keywords ?? [...copy.meta.keywords];

const siteUrl = Astro.site || new URL(Astro.url.origin);
const englishUrl = new URL(withBase("/"), siteUrl).href;
const koreanUrl = new URL(withBase("/ko/"), siteUrl).href;
const localeCanonicalURL = locale === "ko" ? koreanUrl : englishUrl;
const resolvedCanonicalURL = canonicalURL ?? localeCanonicalURL;

const absoluteOgImage = new URL(withBase(ogImage), siteUrl).href;
const publisherUrl = new URL(withBase("/"), siteUrl).href;

const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "ForkWatch",
  applicationCategory: "FinanceApplication",
  description: resolvedDescription,
  inLanguage: locale,
  url: resolvedCanonicalURL,
  publisher: {
    "@type": "Organization",
    name: "Augur",
    url: publisherUrl,
  },
});
---

<!doctype html>
<html class="bg-background text-foreground" lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{resolvedTitle}</title>
    <meta name="description" content={resolvedDescription} />
    <meta name="author" content={author} />
    <meta name="keywords" content={resolvedKeywords.join(", ")} />
    <link rel="canonical" href={resolvedCanonicalURL} />
    <link rel="alternate" hreflang="en" href={englishUrl} />
    <link rel="alternate" hreflang="ko" href={koreanUrl} />
    <link rel="alternate" hreflang="x-default" href={englishUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={resolvedTitle} />
    <meta property="og:description" content={resolvedDescription} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:url" content={resolvedCanonicalURL} />
    <meta property="og:site_name" content="ForkWatch" />
    <meta property="og:locale" content={OG_LOCALES[locale]} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@AugurProject" />
    <meta name="twitter:creator" content="@AugurProject" />
    <meta name="twitter:title" content={resolvedTitle} />
    <meta name="twitter:description" content={resolvedDescription} />
    <meta name="twitter:image" content={absoluteOgImage} />

    <meta name="theme-color" content="#16A34A" />
    <meta name="application-name" content="ForkWatch" />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <link rel="apple-touch-icon" href={withBase("/favicon.svg")} />

    <link rel="dns-prefetch" href="//etherscan.io" />
    <link rel="dns-prefetch" href="//github.com" />

    <script
      is:inline
      type="application/ld+json"
      set:html={structuredData}
    ></script>
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased">
    <div aria-hidden="true" class="grid-tunnel"></div>
    <slot />
  </body>
</html>
