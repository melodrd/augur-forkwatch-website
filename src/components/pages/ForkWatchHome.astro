---
import { ForkOverview } from "@/components/fork/ForkOverview";
import { ForkRepCheckSection } from "@/components/fork/ForkRepCheckSection";
import {
  ExchangeSupportSection,
  ScamWarningSection,
} from "@/components/fork/ForkResourceSections";
import { SiteFooter } from "@/components/layout/SiteFooter";
import { SiteHeader } from "@/components/layout/SiteHeader";
import { getCopy } from "@/i18n";
import type { Locale } from "@/i18n/locales";
import ForkWatchLayout from "@/layouts/ForkWatchLayout.astro";
import migrationProgress from "../../../public/data/migration-progress.json";

type Props = {
  locale: Locale;
};

const { locale } = Astro.props;
const copy = getCopy(locale);
---

<ForkWatchLayout
  dateModified={migrationProgress.checkedAt}
  description={copy.meta.description}
  locale={locale}
  title={copy.meta.title}
>
  <div class="ambient-page min-h-screen bg-background text-foreground">
    <SiteHeader client:load locale={locale} />
    <main
      class="mx-auto flex max-w-7xl flex-col gap-8 px-4 py-6 sm:px-6 lg:px-8"
    >
      <ForkOverview client:load locale={locale} />
      <ScamWarningSection locale={locale} />
      <ExchangeSupportSection client:visible locale={locale} />
      <ForkRepCheckSection client:visible locale={locale} />
    </main>
    <SiteFooter locale={locale} />
  </div>
</ForkWatchLayout>
